generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Statut {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

model Admin {
  id            String           @id @default(uuid())
  email         String           @unique
  passwordHash  String
  nom           String
  criteres      CritereScoring[]
  createdAt     DateTime         @default(now())
}

model Candidat {
  id                  String       @id @default(uuid())
  nom                 String
  prenom              String
  email               String
  telephone           String?
  ville               String?
  photoUrl            String?
  titre               String?
  secteurActivite     String?
  metier              String?
  metierCode          String?
  niveauQualification String?
  anneesExperience    String?
   cvKey               String? 
  statut              Statut       @default(EN_ATTENTE)
  score               Int          @default(0)
  dateEnvoi           DateTime     @default(now())
  dateTraite          DateTime?

  formations   Formation[]
  experiences  Experience[]
  competences  Competence[]
  langues      Langue[]
  liens        Lien[]
  emails       EmailLog[]
}

model Formation {
  id             String    @id @default(uuid())
  candidat       Candidat  @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  candidatId     String
  niveau         String
  etablissement  String
  diplome        String
  anneeDebut     Int?
  anneeFin       Int?
}

model Experience {
  id           String    @id @default(uuid())
  candidat     Candidat  @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  candidatId   String
  poste        String
  entreprise   String
  dateDebut    DateTime?
  dateFin      DateTime?
  description  String?
}

model Competence {
  id          String    @id @default(uuid())
  candidat    Candidat  @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  candidatId  String
  nom         String
}

model Langue {
  id          String    @id @default(uuid())
  candidat    Candidat  @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  candidatId  String
  nom         String
  niveau      String
}

enum TypeLien {
  LINKEDIN
  GITHUB
  PORTFOLIO
  AUTRE
}

model Lien {
  id          String    @id @default(uuid())
  candidat    Candidat  @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  candidatId  String
  type        TypeLien
  url         String
}

enum TypeCritere {
  MOT_CLE
  EXPERIENCE_MIN
  LANGUE
}

model CritereScoring {
  id       String      @id @default(uuid())
  admin    Admin       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId  String
  type     TypeCritere @default(MOT_CLE)
  nom      String
  valeur   String?
  poids    Int
  actif    Boolean     @default(true)
}

model EmailLog {
  id          String    @id @default(uuid())
  candidat    Candidat  @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  candidatId  String
  type        String
  dateEnvoi   DateTime  @default(now())
  statut      String    @default("envoye")
}
