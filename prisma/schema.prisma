model Candidat {
  id                   String       @id @default(uuid())
  nom                  String
  prenom               String
  email                String
  telephone            String?
  ville                String?
  secteurActivite      String?
  metier               String?
  metierCode           String?
  niveauQualification  String?
  photoUrl             String?
  titre                String?
  statut               Statut       @default(EN_ATTENTE)
  score                Int          @default(0)
  dateEnvoi            DateTime     @default(now())
  dateTraite           DateTime?

  formations   Formation[]
  experiences  Experience[]
  competences  Competence[]
  langues      Langue[]
  liens        Lien[]
  emails       EmailLog[]
}